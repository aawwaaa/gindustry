{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:codetools.getLatestGodotPid}",
            "justMyCode": true
        },
        {
            "name": "Launch Godot",
            "type": "godot",
            "request": "launch",
            "project": "${workspaceFolder}",
            "address": "127.0.0.1",
            "port": 6007,
            "scene": "main",
            "additional_options": "",
            "preLaunchTask": "build"
        },
        {
            "name": "SourceGenerator",
            "type": "coreclr",
            "request": "attach",
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "Debug",
            "configurations": [
                "Launch Godot",
                ".NET Core Attach"
            ],
        }
    ]
}